3.3 配置类

```swift
import Foundation

enum SuperResolutionMode: String, CaseIterable, Identifiable {
    case disabled = "关闭"
    case auto = "自动（推荐）"
    case force = "强制开启"

    var id: String { rawValue }
}

struct SuperResolutionConfig {
    /// 根据输入分辨率决定是否启用超分
    static func shouldEnable(
        inputWidth: Int,
        mode: SuperResolutionMode
    ) -> Bool {
        switch mode {
        case .disabled:
            return false
        case .force:
            return true
        case .auto:
            // 仅对 ≤ 720p 输入启用
            return inputWidth <= 1280
        }
    }

    /// 判断输入是否需要缩放到模型固定尺寸
    static func needsResize(inputWidth: Int, inputHeight: Int) -> Bool {
        return inputWidth != PiperSREngine.inputWidth ||
               inputHeight != PiperSREngine.inputHeight
    }
}
```

4. 管线集成

4.1 VideoPipeline 修改

在 VideoPipeline 的推理阶段（inferenceStage 或 processSegment）中，在调用 RIFE Lite 插帧之前插入 PiperSR 超分步骤：

```swift
// 在推理阶段，每帧解码后、插帧前
if let srEngine = superResolutionEngine,
   SuperResolutionConfig.shouldEnable(inputWidth: originalWidth, mode: srMode) {

    // 缩放到 640×360（如需要）
    let resized = resizeBuffer(pixelBuffer, to: CGSize(
        width: PiperSREngine.inputWidth,
        height: PiperSREngine.inputHeight
    ))

    // 执行超分
    if let upscaled = srEngine.upscale(resized) {
        // 用超分后的帧替换原始帧，继续进入 RIFE 插帧
        processedBuffer = upscaled
    }
}
```

4.2 管线顺序

```
AVAssetReader 解码
      ↓
  [可选] PiperSR 2x 超分
      ↓
  RIFE Lite 插帧
      ↓
  AVAssetWriter 编码
```

注意：PiperSR 的 2x 放大发生在 RIFE 之前，因此 RIFE 的输入尺寸从原始分辨率变为超分后的分辨率（如 640×360 → 1280×720）。需要相应调整 FrameInterpolator 的 inputWidth / inputHeight。

4.3 内存与性能考量

指标 数值
单帧超分推理 ~22.5 ms（ANE）
单帧超分 + 插帧 ~50–70 ms
额外内存 输入 640×360 BGRA ≈ 0.88 MB，输出 1280×720 BGRA ≈ 3.5 MB

超分使每帧的处理时间增加约 50%，但在 A16 及以上设备上仍可保持近实时处理。

5. 模型转换（可选）

如果官方提供的 .mlpackage 无法直接使用（如输入尺寸不匹配），可通过 GitHub Actions 重新转换：

```python
import coremltools as ct
import torch

# 加载 PiperSR PyTorch 权重
model = load_pipersr_weights("pipersr_2x.pth")
model.eval()

# 固定输入尺寸 640×360
example_input = torch.randn(1, 3, 360, 640)

# Trace
traced = torch.jit.trace(model, example_input)

# 转换为 Core ML
mlmodel = ct.convert(
    traced,
    inputs=[ct.TensorType(name="input", shape=(1, 3, 360, 640))],
    outputs=[ct.TensorType(name="output")],
    minimum_deployment_target=ct.target.iOS16,
    compute_precision=ct.precision.FLOAT16,
    convert_to="mlprogram"
)

mlmodel.save("PiperSR_2x_video_720p.mlpackage")
```

关键约束：所有操作必须 ANE 原生执行。转换后使用 MLModel 的 computeUnits = .all，并通过 os_signpost 验证推理是否在 ANE 上完成。

6. 性能调优

6.1 ANE 利用率验证

```swift
let signposter = OSSignposter(subsystem: "com.yourapp.frameinterpolation", category: "sr")
let state = signposter.beginInterval("PiperSR-Inference")
let output = srEngine.upscale(pixelBuffer)
signposter.endInterval("PiperSR-Inference", state)
```

在 Instruments 中使用 os_signpost 模板，确认 PiperSR-Inference 区间出现在 ANE 轨道上，而非 GPU 或 CPU 轨道。

6.2 设备降级策略

设备芯片 超分策略
A16 及以上 启用 PiperSR，1080p 输出
A14 / A15 启用 PiperSR，720p 输出
A13 及以下 关闭 PiperSR，直接补帧

通过 DeviceCapability.tier 判断，在 UI 中自动禁用超分选项。

6.3 热状态降级

在 ThermalMonitor 中增加超分降级逻辑：

```swift
var effectiveSRMode: SuperResolutionMode {
    if ThermalMonitor.shared.shouldDegrade {
        return .disabled  // 过热时关闭超分
    }
    return userSRMode
}
```

