3.2 核心类设计

```swift
import CoreML
import CoreVideo
import Metal

final class PiperSREngine {
    private let model: MLModel
    private let device: MTLDevice
    private let commandQueue: MTLCommandQueue

    // PiperSR 固定输入尺寸
    static let inputWidth  = 640
    static let inputHeight = 360
    static let outputWidth  = 1280
    static let outputHeight = 720

    init?() {
        guard let modelURL = Bundle.main.url(
            forResource: "PiperSR_2x_video_720p",
            withExtension: "mlmodelc"
        ) else { return nil }

        let config = MLModelConfiguration()
        config.computeUnits = .all  // 优先 ANE

        guard let model = try? MLModel(contentsOf: modelURL, configuration: config),
              let device = MTLCreateSystemDefaultDevice(),
              let queue = device.makeCommandQueue() else { return nil }

        self.model = model
        self.device = device
        self.commandQueue = queue
    }

    /// 对单帧执行 2x 超分
    /// - Parameter pixelBuffer: 640×360 BGRA CVPixelBuffer
    /// - Returns: 1280×720 BGRA CVPixelBuffer，失败返回 nil
    func upscale(_ pixelBuffer: CVPixelBuffer) -> CVPixelBuffer? {
        // 1. CVPixelBuffer → MLMultiArray (NCHW FP16)
        guard let inputArray = makeInputArray(from: pixelBuffer) else { return nil }

        // 2. Core ML 推理
        guard let prediction = try? model.prediction(from: [
            "input": inputArray
        ]) else { return nil }

        // 3. 获取输出并转换为 CVPixelBuffer
        guard let outputArray = prediction.featureValue(for: "output")?.multiArrayValue else {
            return nil
        }

        return makePixelBuffer(from: outputArray)
    }

    // MARK: - Private
    private func makeInputArray(from pixelBuffer: CVPixelBuffer) -> MLMultiArray? {
        // BGRA → NCHW FP16，归一化到 [0,1]
        // 使用 Metal Compute Shader 加速格式转换
        // 具体实现参考 FrameInterpolator 的预处理逻辑
        // ...
        return nil // 占位
    }

    private func makePixelBuffer(from array: MLMultiArray) -> CVPixelBuffer? {
        // NCHW FP16 → BGRA CVPixelBuffer
        // 使用 CVPixelBufferPool 复用缓冲区
        // ...
        return nil // 占位
    }
}
