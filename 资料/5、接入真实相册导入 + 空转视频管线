3. MediaImporter.swift（真实元数据）

```swift
import AVFoundation
import UIKit

enum MediaImporter {
    /// 读取视频元数据：时长、帧率、文件大小、分辨率、缩略图
    static func loadVideoInfo(from url: URL) async throws -> VideoInfo {
        let asset = AVURLAsset(url: url)

        // 时长
        let duration = try await asset.load(.duration)

        // 视频轨道
        let tracks = try await asset.loadTracks(withMediaType: .video)
        guard let track = tracks.first else {
            throw NSError(
                domain: "MediaImporter",
                code: -1,
                userInfo: [NSLocalizedDescriptionKey: "未找到视频轨道"]
            )
        }

        // 帧率
        let fps = try await track.load(.nominalFrameRate)

        // 分辨率与方向
        let naturalSize = try await track.load(.naturalSize)
        let transform = try await track.load(.preferredTransform)
        let displaySize = naturalSize.applying(transform)
        let width = abs(displaySize.width)
        let height = abs(displaySize.height)

        // 文件大小
        let attrs = try? FileManager.default.attributesOfItem(atPath: url.path)
        let fileSize = (attrs?[.size] as? Int64) ?? 0
        let sizeMB = Double(fileSize) / 1024 / 1024

        // 缩略图
        let thumbnail = try? await generateThumbnail(asset: asset)

        return VideoInfo(
            url: url,
            fileName: url.lastPathComponent,
            duration: CMTimeGetSeconds(duration),
            originalFPS: Double(fps),
            originalSizeMB: sizeMB,
            width: Int(width),
            height: Int(height),
            thumbnail: thumbnail
        )
    }

    private static func generateThumbnail(asset: AVAsset) async throws -> UIImage? {
        let generator = AVAssetImageGenerator(asset: asset)
        generator.appliesPreferredTrackTransform = true
        generator.maximumSize = CGSize(width: 320, height: 320)

        let time = CMTime(seconds: 0.5, preferredTimescale: 600)
        let cgImage = try await generator.image(at: time).image
        return UIImage(cgImage: cgImage)
    }
}
