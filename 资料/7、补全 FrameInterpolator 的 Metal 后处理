4. 重写 FrameInterpolator.swift

```swift
import CoreML
import CoreVideo
import Metal
import Accelerate

final class FrameInterpolator {
    // MARK: - Metal
    private let helper = MetalComputeHelper.shared
    private let commandQueue: MTLCommandQueue
    private let preprocessPipeline: MTLComputePipelineState
    private let sigmoidPipeline: MTLComputePipelineState
    private let warpPipeline: MTLComputePipelineState
    private let blendPipeline: MTLComputePipelineState
    private let rgbaToBgraPipeline: MTLComputePipelineState

    // MARK: - Model
    private let model: MLModel

    // MARK: - Buffer
    private let inputWidth: Int
    private let inputHeight: Int
    private let flowBuffer: MTLBuffer
    private let maskBuffer: MTLBuffer
    private let frame0Buffer: MTLBuffer
    private let frame1Buffer: MTLBuffer

    // MARK: - PixelBufferPool
    private let pool: PixelBufferPool

    init?() {
        // ---- 加载模型 ----
        guard let modelURL = Bundle.main.url(forResource: "RIFE_Lite", withExtension: "mlmodelc") else {
            return nil
        }
        let config = MLModelConfiguration()
        config.computeUnits = .all
        guard let model = try? MLModel(contentsOf: modelURL, configuration: config) else {
            return nil
        }
        self.model = model

        // ---- Metal 管线 ----
        guard let queue = helper.device.makeCommandQueue(),
              let library = helper.device.makeDefaultLibrary(),
              let pre = library.makeFunction(name: "bgra_to_nchw"),
              let sig = library.makeFunction(name: "sigmoid_mask"),
              let warp = library.makeFunction(name: "warp_frame"),
              let blend = library.makeFunction(name: "blend_frames"),
              let rgb2bgra = library.makeFunction(name: "rgba_to_bgra") else {
            return nil
        }
        self.commandQueue = queue

        do {
            self.preprocessPipeline = try helper.device.makeComputePipelineState(function: pre)
            self.sigmoidPipeline    = try helper.device.makeComputePipelineState(function: sig)
            self.warpPipeline       = try helper.device.makeComputePipelineState(function: warp)
            self.blendPipeline      = try helper.device.makeComputePipelineState(function: blend)
            self.rgbaToBgraPipeline = try helper.device.makeComputePipelineState(function: rgb2bgra)
        } catch {
            return nil
        }

        // ---- 固定输入尺寸 ----
        self.inputWidth = 512
        self.inputHeight = 512

        // ---- 预分配 MTLBuffer ----
        let plane = inputWidth * inputHeight
        let frameBytes = plane * 3 * MemoryLayout<Float16>.size
        let flowBytes  = plane * 2 * MemoryLayout<Float16>.size
        let maskBytes  = plane * 1 * MemoryLayout<Float16>.size

        guard let f0 = helper.device.makeBuffer(length: frameBytes, options: .storageModeShared),
              let f1 = helper.device.makeBuffer(length: frameBytes, options: .storageModeShared),
              let fl = helper.device.makeBuffer(length: flowBytes, options: .storageModeShared),
              let mk = helper.device.makeBuffer(length: maskBytes, options: .storageModeShared) else {
            return nil
        }
        self.frame0Buffer = f0
        self.frame1Buffer = f1
        self.flowBuffer   = fl
        self.maskBuffer   = mk

        // ---- 输出 PixelBufferPool ----
        self.pool = PixelBufferPool()
        pool.configure(width: inputWidth, height: inputHeight, format: kCVPixelFormatType_32BGRA)
    }

    // MARK: - Public
    /// 输入前后两帧（任意尺寸），输出中间帧（与输入同尺寸）
    func interpolate(frame0: CVPixelBuffer, frame1: CVPixelBuffer) -> CVPixelBuffer? {
        let outputWidth = CVPixelBufferGetWidth(frame0)
        let outputHeight = CVPixelBufferGetHeight(frame0)

        guard let commandBuffer = commandQueue.makeCommandBuffer() else { return nil }

        // 1) 缩放到 512x512 并转为 BGRA 纹理
        guard let tex0 = helper.makeTexture(from: frame0),
              let tex1 = helper.makeTexture(from: frame1) else { return nil }

        // 2) Metal 预处理：BGRA → NCHW Float16
        encodePreprocess(commandBuffer: commandBuffer, source: tex0, dstBuffer: frame0Buffer)
        encodePreprocess(commandBuffer: commandBuffer, source: tex1, dstBuffer: frame1Buffer)

        commandBuffer.commit()
        commandBuffer.waitUntilCompleted()

        // 3) Core ML 推理
        guard let prediction = try? model.prediction(from: [
            "frame0": makeMultiArray(from: frame0Buffer, shape: [1, 3, inputHeight, inputWidth]),
            "frame1": makeMultiArray(from: frame1Buffer, shape: [1, 3, inputHeight, inputWidth])
        ]) else { return nil }

        guard let flowArray = prediction.featureValue(for: "flow")?.multiArrayValue,
              let maskArray = prediction.featureValue(for: "mask")?.multiArrayValue else {
            return nil
        }

        // 4) 把 MLMultiArray 拷回 MTLBuffer
        copyToBuffer(multiArray: flowArray, buffer: flowBuffer)
        copyToBuffer(multiArray: maskArray, buffer: maskBuffer)

        // 5) Metal 后处理：Sigmoid → Warp 0 → Warp 1 → Blend → RGBA→BGRA
        guard let output = postprocess(
            commandBuffer: commandQueue.makeCommandBuffer()!,
            originalFrame0: tex0,
            originalFrame1: tex1,
            outputWidth: outputWidth,
            outputHeight: outputHeight
        ) else { return nil }

        return output
    }

    // MARK: - Encode Preprocess
    private func encodePreprocess(
        commandBuffer: MTLCommandBuffer,
        source: MTLTexture,
        dstBuffer: MTLBuffer
    ) {
        guard let encoder = commandBuffer.makeComputeCommandEncoder() else { return }
        encoder.setComputePipelineState(preprocessPipeline)
        encoder.setTexture(source, index: 0)
        encoder.setBuffer(dstBuffer, offset: 0, index: 0)

        var width = UInt32(inputWidth)
        var height = UInt32(inputHeight)
        encoder.setBytes(&width, length: MemoryLayout<UInt32>.size, index: 1)
        encoder.setBytes(&height, length: MemoryLayout<UInt32>.size, index: 2)

        let threadGroup = MTLSize(width: 16, height: 16, depth: 1)
        let threadGrid = MTLSize(
            width: (inputWidth + 15) / 16,
            height: (inputHeight + 15) / 16,
            depth: 1
        )
        encoder.dispatchThreadgroups(threadGrid, threadsPerThreadgroup: threadGroup)
        encoder.endEncoding()
    }

    // MARK: - Encode Sigmoid
    private func encodeSigmoid(commandBuffer: MTLCommandBuffer) {
        guard let encoder = commandBuffer.makeComputeCommandEncoder() else { return }
        encoder.setComputePipelineState(sigmoidPipeline)
        encoder.setBuffer(maskBuffer, offset: 0, index: 0)

        var count = UInt32(inputWidth * inputHeight)
        encoder.setBytes(&count, length: MemoryLayout<UInt32>.size, index: 1)

        let threadGroup = MTLSize(width: 256, height: 1, depth: 1)
        let threadGrid = MTLSize(
            width: (inputWidth * inputHeight + 255) / 256,
            height: 1,
            depth: 1
        )
        encoder.dispatchThreadgroups(threadGrid, threadsPerThreadgroup: threadGroup)
        encoder.endEncoding()
    }

    // MARK: - Encode Warp
    private func encodeWarp(
        commandBuffer: MTLCommandBuffer,
        source: MTLTexture,
        destination: MTLTexture,
        scale: Float
    ) {
        guard let encoder = commandBuffer.makeComputeCommandEncoder() else { return }
        encoder.setComputePipelineState(warpPipeline)
        encoder.setTexture(source, index: 0)
        encoder.setTexture(destination, index: 1)
        encoder.setBuffer(flowBuffer, offset: 0, index: 0)

        var width = UInt32(inputWidth)
        var height = UInt32(inputHeight)
        var s = scale
        encoder.setBytes(&width, length: MemoryLayout<UInt32>.size, index: 1)
        encoder.setBytes(&height, length: MemoryLayout<UInt32>.size, index: 2)
        encoder.setBytes(&s, length: MemoryLayout<Float>.size, index: 3)

        let threadGroup = MTLSize(width: 16, height: 16, depth: 1)
        let threadGrid = MTLSize(
            width: (inputWidth + 15) / 16,
            height: (inputHeight + 15) / 16,
            depth: 1
        )
        encoder.dispatchThreadgroups(threadGrid, threadsPerThreadgroup: threadGroup)
        encoder.endEncoding()
    }

    // MARK: - Encode Blend
    private func encodeBlend(
        commandBuffer: MTLCommandBuffer=,
        warped0: MTLTexture,
        warped1: MTLTexture,
        output: MTLTexture
    ) {
        guard let0 encoder = commandBuffer.makeComputeCommandEncoder() else { return }
        encoder.setComputePipelineState(blendPipeline)
        encoder.setTexture(warped.0, index: 0)
        encoder.setTexture(warped1, index: 1)
        encoder.setTexture(output, index: 2)
5        encoder.setBuffer(maskBuffer, offset: 0, index: 0)

        var width = UInt32(inputWidth)
        encoder.setBytes(&width, length: MemoryLayout<UInt32>.size, index: 1)

        let threadGroup = MTLSize(width: 16, height: 16, depth: 1)
        let threadGrid = MTLSize(
            width: (inputWidth + 15) / 16,
            height: (inputHeight + 15) / 16,
            depth: 1
        )
        encoder.dispatchThreadgroups(threadGrid, threadsPerThreadgroup: threadGroup)
        encoder.endEncoding()
    }

    // MARK: - Postprocess
    private func postprocess(
        commandBuffer: MTLCommandBuffer,
        originalFrame0: MTLTexture,
        originalFrame1: MTLTexture,
        outputWidth: Int,
        outputHeight: Int
    ) -> CVPixelBuffer? {
        guard let warped0 = helper.makeEmptyTexture(width: inputWidth, height: inputHeight),
              let warped1 = helper.makeEmptyTexture(width: inputWidth, height: inputHeight),
              let blended = helper.makeEmptyTexture(width: inputWidth, height: inputHeight) else {
            return nil
        }

        // Sigmoid mask
        encodeSigmoid(commandBuffer: commandBuffer)

        // Warp：frame0 沿 +flow 走 t=0.5；frame1 沿 -flow 走 t
        encodeWarp(commandBuffer: commandBuffer, source: originalFrame0, destination: warped0, scale: 0.5)
        encodeWarp(commandBuffer: commandBuffer, source: originalFrame1, destination: warped1, scale: -0.5)

        // Blend
        encodeBlend(commandBuffer: commandBuffer, warped0: warped0, warped1: warped1, output: blended)

        commandBuffer.commit()
        commandBuffer.waitUntilCompleted()

        // 输出到 CVPixelBuffer
        guard let outputBuffer = pool.makeBuffer() else { return nil }
        helper.copy(texture: blended, to: outputBuffer)
        return outputBuffer
    }

    // MARK: - MLMultiArray <-> MTLBuffer
    private func makeMultiArray(from buffer: MTLBuffer, shape: [NSNumber]) -> MLMultiArray? {
        guard let array = try? MLMultiArray(shape: shape, dataType: .float16) else { return nil }
        memcpy(array.dataPointer, buffer.contents(), buffer.length)
        return array
    }

    private func copyToBuffer(multiArray: MLMultiArray, buffer: MTLBuffer) {
        let byteCount = multiArray.count * MemoryLayout<Float16>.size
        memcpy(buffer.contents(), multiArray.dataPointer, min(byteCount, buffer.length))
    }
}
