4. 完整 GitHub Actions 工作流

4.1 .github/workflows/ios-build.yml

```yaml
name: iOS Build

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]
  workflow_dispatch:
    inputs:
      release:
        description: '是否发布 Release'
        required: false
        default: 'false'
        type: choice
        options: ['true', 'false']

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: macos-15
    timeout-minutes: 40

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Show environment
        run: |
          xcodebuild -version
          sw_vers

      - name: Install XcodeGen
        run: brew install xcodegen

      - name: Compute version
        id: version
        run: |
          if [[ "${GITHUB_REF}" == refs/tags/v* ]]; then
            VERSION="${GITHUB_REF#refs/tags/v}"
          else
            VERSION=$(grep -m1 'MARKETING_VERSION:' project.yml | awk '{print $2}' | tr -d '"')
          fi
          BUILD_NUMBER=${{ github.run_number }}
          echo "version=$VERSION" >> $GITHUB_OUTPUT
          echo "build=$BUILD_NUMBER" >> $GITHUB_OUTPUT
          echo "📦 Version: $VERSION (build $BUILD_NUMBER)"

      - name: Inject version into project.yml
        run: |
          sed -i '' "s/MARKETING_VERSION: .*/MARKETING_VERSION: \"${{ steps.version.outputs.version }}\"/" project.yml
          sed -i '' "s/CURRENT_PROJECT_VERSION: .*/CURRENT_PROJECT_VERSION: \"${{ steps.version.outputs.build }}\"/" project.yml
          grep -E 'MARKETING_VERSION|CURRENT_PROJECT_VERSION' project.yml

      - name: Cache Swift Packages
        uses: actions/cache@v4
        with:
          path: |
            ~/Library/Caches/org.swift.swiftpm
            ~/Library/Developer/Xcode/DerivedData
          key: ${{ runner.os }}-spm-${{ hashFiles('**/project.yml', '**/Package.resolved') }}
          restore-keys: |
            ${{ runner.os }}-spm-

      - name: Generate Xcode project
        run: xcodegen generate

      - name: Archive (Unsigned)
        run: |
          xcodebuild archive \
            -project FrameInterpolation.xcodeproj \
            -scheme FrameInterpolation \
            -configuration Release \
            -destination 'generic/platform=iOS' \
            -archivePath build/FrameInterpolation.xcarchive \
            CODE_SIGN_IDENTITY="" \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGNING_ALLOWED=NO \
            | xcpretty || true

      - name: Export Unsigned IPA
        run: |
          mkdir -p build/Payload
          cp -r build/FrameInterpolation.xcarchive/Products/Applications/FrameInterpolation.app build/Payload/
          cd build
          zip -r "FrameInterpolation-${{ steps.version.outputs.version }}-${{ steps.version.outputs.build }}.ipa" Payload/
          ls -lh *.ipa

      - name: Upload IPA Artifact
        uses: actions/upload-artifact@v4
        with:
          name: FrameInterpolation-${{ steps.version.outputs.version }}-${{ steps.version.outputs.build }}
          path: build/*.ipa
          retention-days: 30

      - name: Generate changelog
        id: changelog
        if: startsWith(github.ref, 'refs/tags/v') || github.event.inputs.release == 'true'
        run: |
          PREVIOUS_TAG=$(git describe --tags --abbrev=0 HEAD^ 2>/dev/null || echo "")
          if [ -z "$PREVIOUS_TAG" ]; then
            RANGE=""
          else
            RANGE="$PREVIOUS_TAG..HEAD"
          fi
          {
            echo "## 变更内容"
            echo ""
            git log $RANGE --pretty=format:"- %s (%h)" --no-merges | head -50
            echo ""
          } > changelog.md
          cat changelog.md

      - name: Create Release
        if: startsWith(github.ref, 'refs/tags/v') || github.event.inputs.release == 'true'
        uses: softprops/action-gh-release@v2
        with:
          tag_name: ${{ startsWith(github.ref, 'refs/tags/v') && github.ref_name || format('v{0}-build{1}', steps.version.outputs.version, steps.version.outputs.build) }}
          name: ${{ format('v{0} (build {1})', steps.version.outputs.version, steps.version.outputs.build) }}
          body_path: changelog.md
          files: build/*.ipa
          draft: false
          prerelease: false
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
```

4.2 关键点说明

配置 作用
concurrency 同一分支新推送取消旧构建，节省额度
fetch-depth: 0 拉取完整历史，生成 changelog 用
sed 注入版本 把 tag / run_number 写入 project.yml
xcpretty 可选，让日志更简洁
softprops/action-gh-release 自动创建 Release 并上传 IPA
GITHUB_TOKEN 自动提供，无需额外配置

