3. AppState.swift

```swift
import SwiftUI
import Combine

@MainActor
final class AppState: ObservableObject {
    // 首页
    @Published var recentRecords: [RecentRecord] = []
    @Published var isImporting = false

    // 参数设置
    @Published var selectedVideo: VideoInfo?
    @Published var frameMultiplier: FrameMultiplier = .x2
    @Published var outputResolution: OutputResolution = .auto
    @Published var fastMode: Bool = false

    // 处理中
    @Published var isProcessing = false
    @Published var progress: Double = 0
    @Published var processedFrames: Int = 0
    @Published var totalFrames: Int = 0
    @Published var estimatedRemaining: TimeInterval = 0
    @Published var stage: ProcessingStage = .idle

    // 结果
    @Published var outputURL: URL?

    // Toast
    @Published var toastMessage: String?
    @Published var toastStyle: ToastStyle = .success

    // MARK: - Actions
    func importVideo(from url: URL) {
        // TODO: 使用 AVAsset 读取元数据
        let info = VideoInfo(
            url: url,
            fileName: url.lastPathComponent,
            duration: 12.0,
            originalFPS: 30,
            originalSizeMB: 12.5,
            thumbnail: nil
        )
        selectedVideo = info
    }

    func startProcessing() {
        guard selectedVideo != nil else { return }
        isProcessing = true
        stage = .decoding
        progress = 0
        // TODO: 调用 VideoPipeline
        // 模拟进度
        Task {
            for i in 1...100 {
                try? await Task.sleep(nanoseconds: 50_000_000)
                progress = Double(i) / 100.0
                processedFrames = i * 3
                totalFrames = 300
                if i > 30 && i < 70 { stage = .inferring }
                if i >= 70 { stage = .encoding }
                if i == 100 {
                    stage = .finished
                    isProcessing = false
                    outputURL = selectedVideo?.url // TODO: 替换为真实输出
                }
            }
        }
    }

    func cancelProcessing() {
        isProcessing = false
        stage = .idle
        progress = 0
        // TODO: 取消 AVAssetReader / Writer 任务
    }

    func showToast(_ message: String, style: ToastStyle = .success) {
        toastMessage = message
        toastStyle = style
        Task {
            try? await Task.sleep(nanoseconds: 2_000_000_000)
            withAnimation { toastMessage = nil }
        }
    }
}

enum ToastStyle {
    case success, error, warning
}
