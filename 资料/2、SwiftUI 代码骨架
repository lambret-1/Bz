import SwiftUI

struct SettingsView: View {
    @EnvironmentObject var appState: AppState
    @Environment(\.dismiss) private var dismiss

    @State private var showCancelConfirm = false

    var body: some View {
        NavigationStack {
            ScrollView {
                VStack(alignment: .leading, spacing: DesignTokens.Spacing.l) {
                    // Video Preview Card
                    if let video = appState.selectedVideo {
                        CardView {
                            VStack(spacing: DesignTokens.Spacing.s) {
                                HStack(spacing: DesignTokens.Spacing.m) {
                                    RoundedRectangle(cornerRadius: DesignTokens.Radius.s)
                                        .fill(DesignTokens.Colors.bgTertiary)
                                        .frame(width: 80, height: 45)
                                        .overlay(
                                            Image(systemName: "video.fill")
                                                .foregroundColor(DesignTokens.Colors.textSecondary)
                                        )
                                    VStack(alignment: .leading, spacing: 2) {
                                        Text(video.fileName)
                                            .font(.headline)
                                            .lineLimit(1)
                                        Text("时长 \(formattedDuration(video.duration)) · 原始 \(Int(video.originalFPS))fps")
                                            .font(.caption)
                                            .foregroundColor(DesignTokens.Colors.textSecondary)
                                    }
                                    Spacer()
                                }
                                Divider()
                                HStack {
                                    Text("原始大小 \(String(format: "%.1f", video.originalSizeMB)) MB")
                                        .font(.caption)
                                        .foregroundColor(DesignTokens.Colors.textSecondary)
                                    Spacer()
                                    Text("预计输出 \(estimatedSize(video)) MB")
                                        .font(.caption)
                                        .foregroundColor(DesignTokens.Colors.accent)
                                }
                            }
                        }
                    }

                    // Frame Multiplier
                    VStack(alignment: .leading, spacing: DesignTokens.Spacing.s) {
                        Text("补帧倍数")
                            .font(.headline)
                        SegmentedPicker(
                            items: FrameMultiplier.allCases,
                            selection: $appState.frameMultiplier,
                            label: { $0.label }
                        )
                        if appState.frameMultiplier == .x4 {
                            Text("4x 仅 A16 及以上设备支持")
                                .font(.caption)
                                .foregroundColor(DesignTokens.Colors.warning)
                        }
                    }

                    // Output Resolution
                    VStack(alignment: .leading, spacing: DesignTokens.Spacing.s) {
                        Text("输出分辨率")
                            .font(.headline)
                        SegmentedPicker(
                            items: OutputResolution.allCases,
                            selection: $appState.outputResolution,
                            label: { $0.rawValue }
                        )
                    }

                    // Fast Mode
                    CardView {
                        HStack {
                            VStack(alignment: .leading, spacing: 2) {
                                Text("快速模式")
                                    .font(.headline)
                                Text("使用 Metal 帧混合，速度更快")
                                    .font(.caption)
                                    .foregroundColor(DesignTokens.Colors.textSecondary)
                            }
                            Spacer()
                            Toggle("", isOn: $appState.fastMode)
                                .labelsHidden()
                        }
                    }

                    // Estimated Info
                    CardView {
                        VStack(spacing: DesignTokens.Spacing.s) {
                            infoRow("预计耗时", value: estimatedTime())
                            Divider()
                            infoRow("预计输出大小", value: "\(estimatedSize(appState.selectedVideo)) MB")
                            Divider()
                            infoRow("输出帧率", value: "\(Int(appState.selectedVideo?.originalFPS ?? 30) * appState.frameMultiplier.rawValue)fps")
                        }
                    }

                    Spacer(minLength: DesignTokens.Spacing.xl)
                }
                .padding(DesignTokens.Spacing.m)
            }
            .background(DesignTokens.Colors.bgPrimary)
            .navigationTitle("参数设置")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar {
                ToolbarItem(placement: .cancellationAction) {
                    Button("取消") { dismiss() }
                }
            }
            .safeAreaInset(edge: .bottom) {
                PrimaryButton(title: "开始补帧", isLoading: appState.isProcessing) {
                    appState.startProcessing()
                }
                .padding(DesignTokens.Spacing.m)
                .background(DesignTokens.Colors.bgPrimary)
            }
            .fullScreenCover(isPresented: $appState.isProcessing) {
                ProcessingView()
                    .environmentObject(appState)
            }
        }
    }

    private func infoRow(_ title: String, value: String) -> some View {
        HStack {
            Text(title)
                .font(.subheadline)
                .foregroundColor(DesignTokens.Colors.textSecondary)
            Spacer()
            Text(value)
                .font(.subheadline.weight(.medium))
        }
    }

    private func formattedDuration(_ duration: TimeInterval) -> String {
        let minutes = Int(duration) / 60
        let seconds = Int(duration) % 60
        return String(format: "%02d:%02d", minutes, seconds)
    }

    private func estimatedSize(_ video: VideoInfo?) -> String {
        guard let video else { return "0" }
        let base = video.originalSizeMB
        let multiplier = Double(appState.frameMultiplier.rawValue) / 2.0
        let resolutionFactor: Double = appState.outputResolution == .p1080 ? 1.5 : 1.0
        return String(format: "%.0f", base * multiplier * resolutionFactor)
    }

    private func estimatedTime() -> String {
        guard let video = appState.selectedVideo else { return "约 0 秒" }
        let base = video.duration * 0.2
        let resolutionFactor: Double = appState.outputResolution == .p1080 ? 1.5 : 1.0
        let fastFactor: Double = appState.fastMode ? 0.4 : 1.0
        let seconds = base * resolutionFactor * fastFactor * Double(appState.frameMultiplier.rawValue) / 2.0
        if seconds < 60 { return String(format: "约 %.0f 秒", seconds) }
        return String(format: "约 %.0f 分钟", seconds / 60)
    }
}
