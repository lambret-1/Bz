                    } label: {
                        Image(systemName: "gearshape")
                            .font(.title2)
                            .frame(width: DesignTokens.minTapArea, height: DesignTokens.minTapArea)
                    }
                }

                // Import Card
                CardView {
                    VStack(spacing: DesignTokens.Spacing.m) {
                        Image(systemName: "photo.on.rectangle.angled")
                            .font(.system(size: 48))
                            .foregroundColor(DesignTokens.Colors.accent)
                        Text("导入视频开始补帧")
                            .font(.headline)
                        Text("支持 30fps → 60fps，完全本地处理")
                            .font(.subheadline)
                            .foregroundColor(DesignTokens.Colors.textSecondary)
                            .multilineTextAlignment(.center)

                        PrimaryButton(title: "从相册选择") {
                            // TODO: 接入 PHPickerViewController
                            appState.showToast("请接入相册选择器", style: .warning)
                        }
                        Button("从文件选择") {
                            showFileImporter = true
                        }
                        .font(.subheadline)
                        .foregroundColor(DesignTokens.Colors.accent)
                    }
                    .frame(maxWidth: .infinity)
                }

                // Recent Records
                HStack {
                    Text("最近记录")
                        .font(.headline)
                    Spacer()
                }

                if appState.recentRecords.isEmpty {
                    EmptyStateView(
                        icon: "video.slash",
                        title: "还没有处理记录",
                        subtitle: "导入一个视频试试吧"
                    )
                    .frame(maxWidth: .infinity)
                } else {
                    ScrollView(.horizontal, showsIndicators: false) {
                        HStack(spacing: DesignTokens.Spacing.m) {
                            ForEach(appState.recentRecords) { record in
                                RecentRecordCard(record: record)
                            }
                        }
                    }
                }
            }
            .padding(DesignTokens.Spacing.m)
        }
        .background(DesignTokens.Colors.bgPrimary)
        .sheet(isPresented: $showSettings) {
            SettingsView()
                .environmentObject(appState)
        }
        .fileImporter(
            isPresented: $showFileImporter,
            allowedContentTypes: [.movie],
            allowsMultipleSelection: false
        ) { result in
            switch result {
            case .success(let urls):
                guard let url = urls.first else { return }
                appState.importVideo(from: url)
            case .failure(let error):
                appState.showToast(error.localizedDescription, style: .error)
            }
        }
        .overlay(alignment: .top) {
            if let message = appState.toastMessage {
                ToastView(message: message, style: appState.toastStyle)
                    .padding(.top, DesignTokens.Spacing.s)
                    .transition(.move(edge: .top).combined(with: .opacity))
            }
        }
    }
}

