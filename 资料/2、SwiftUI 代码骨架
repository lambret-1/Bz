import Foundation

struct VideoInfo: Identifiable, Equatable {
    let id = UUID()
    let url: URL
    let fileName: String
    let duration: TimeInterval
    let originalFPS: Double
    let originalSizeMB: Double
    let thumbnail: Data? // 实际项目可存 UIImage
}

struct RecentRecord: Identifiable, Equatable {
    let id = UUID()
    let fileName: String
    let outputFPS: Double
    let createdAt: Date
    let thumbnailData: Data?
}

enum FrameMultiplier: Int, CaseIterable, Identifiable {
    case x2 = 2
    case x4 = 4
    var id: Int { rawValue }
    var label: String { "\(rawValue)x" }
}

enum OutputResolution: String, CaseIterable, Identifiable {
    case auto = "自动"
    case p720 = "720p"
    case p1080 = "1080p"
    var id: String { rawValue }
}

enum ProcessingStage: String {
    case idle = "准备中"
    case decoding = "正在解码视频…"
    case inferring = "AI 正在计算光流…"
    case encoding = "正在编码输出…"
    case finished = "处理完成"
    case failed = "处理失败"
}
