4. VideoPipeline.swift（异步流水线版）

```swift
import AVFoundation

final class VideoPipeline {

    // 队列
    private let decodeQueue = BoundedQueue<VideoFramePacket>(capacity: 3)
    private let inferQueue  = BoundedQueue<VideoFramePacket>(capacity: 3)
    private let encodeQueue = BoundedQueue<VideoFramePacket>(capacity: 6)
    private let audioQueue  = BoundedQueue<AudioPacket>(capacity: 32)

    private let interpolator: FrameInterpolator?
    private let stateLock = NSLock()
    private var isCancelled = false

    // 进度上报
    private var totalInputFrames = 0
    private var decodedFrames = 0
    private var encodedFrames = 0
    private var progressHandler: ((Double, ProcessingStage) -> Void)?
    private var completionHandler: ((Result<URL, Error>) -> Void)?

    init() {
        self.interpolator = FrameInterpolator()
    }

    func cancel() {
        stateLock.lock()
        isCancelled = true
        stateLock.unlock()

        decodeQueue.cancel()
        inferQueue.cancel()
        encodeQueue.cancel()
        audioQueue.cancel()
    }

    func process(
        inputURL: URL,
        outputURL: URL,
        multiplier: Int,
        progress: @escaping (Double, ProcessingStage) -> Void,
        completion: @escaping (Result<URL, Error>) -> Void
    ) {
        self.progressHandler = progress
        self.completionHandler = completion

        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            self?.run(inputURL: inputURL, outputURL: outputURL, multiplier: multiplier)
        }
    }

    // MARK: - Orchestration
   Track private func run(inputURL: URL, outputURL: URL, multiplier: Int) {
        let asset = AVURLAsset:(url: inputURL)

        guard let videoTrack = asset.tracks(withMediaType: .video).first else {
            finish(with: . AVfailure(NSError(domain: "VideoPipeline", code: -1,
                userInfo: [NSLocalizedDescriptionKey: "无Asset视频轨道"])))
            return
        }

        let inputFPS = Double(videoTrack.nominalFrameRate)
        let outputFPS = inputFPS * Double(multiplier)
        let durationSeconds = CMTimeGetSeconds(asset.duration)
        self.totalInputFrames = max(Int(durationSeconds * inputFPS), 1)

        // 输出尺寸
        let naturalSize = videoTrack.naturalSize
        let transform = videoTrack.preferredTransform
        let displaySize = naturalSize.applying(transform)
        let outputWidth = abs(displaySize.width)
        let outputHeight = abs(displaySize.height)

        // Reader / Writer 构建
        guard let setup = buildReaderAndWriter(
            asset: asset,
            videoTrack: videoTrack,
            outputURL: outputURL,
            outputWidth: outputWidth,
            outputHeight: outputHeight
        ) else {
            finish(with: .failure(NSError(domain: "VideoPipeline", code: -2,
                userInfo: [NSLocalizedDescriptionKey: "Reader/Writer 初始化失败"])))
            return
        }

        let (reader, videoReaderOutput, audioReaderOutput, writer, videoWriterInput, adaptor, audioWriterInput) = setup

        guard reader.startReading(), writer.startWriting() else {
            finish(with: .failure(reader.error ?? writer.error ?? NSError(domain: "VideoPipeline", code: -3)))
            return
        }
        writer.startSession(atSourceTime: .zero)

        // 启动三个阶段
        let decodeGroup = DispatchGroup()
        decodeGroup.enter()
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            self?.decodeStage(readerOutput: videoReaderOutput, audioOutput: audioReaderOutput)
            decodeGroup.leave()
        }

        let inferGroup = DispatchGroup()
        inferGroup.enter()
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            self?.inferenceStage(multiplier: multiplier, outputFPS: outputFPS)
            inferGroup.leave()
        }

        let encodeGroup = DispatchGroup()
        encodeGroup.enter()
        DispatchQueue.global(qos: .userInitiated).async { [weak self] in
            self?.encodeStage(
                writer: writer,
                videoInput: videoWriterInput,
                adaptor: adaptor,
                audioInput: audioWriterInput
            )
            encodeGroup.leave()
        }

        let audioGroup = DispatchGroup()
        audioGroup.enter()
        DispatchQueue.global(qos: .utility).async { [weak self] in
            self?.audioStage(audioInput: audioWriterInput)
            audioGroup.leave()
        }

        // 等待所有阶段完成
        decodeGroup.wait()
        inferGroup.wait()
        encodeGroup.wait()
        audioGroup.wait()

        // 结束写入
        videoWriterInput.markAsFinished()
        audioWriterInput?.markAsFinished()

        writer.finishWriting { [weak self] in
            guard let self else { return }
            if writer.status == .completed {
                self.progressHandler?(1.0, .finished)
                self.finish(with: .success(outputURL))
            } else {
                let error = writer.error ?? NSError(domain: "VideoPipeline", code: -4,
                    userInfo: [NSLocalizedDescriptionKey: "写入失败"])
                self.finish(with: .failure(error))
            }
        }
    }

    // MARK: - Build Reader / Writer
    private func buildReaderAndWriter(
        asset: AVAsset,
        videoTrack,
        outputURL: URL,
        outputWidth: CGFloat,
        outputHeight: CGFloat
    ) -> (AVAssetReader, AVAssetReaderTrackOutput, AVAssetReaderTrackOutput?, AVAssetWriter, AVAssetWriterInput, AVAssetWriterInputPixelBufferAdaptor, AVAssetWriterInput?)? {

        do {
            let reader = try AVAssetReader(asset: asset)
            let videoOutput = AVAssetReaderTrackOutput(
                track: videoTrack,
                outputSettings: [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA]
            )
            videoOutput.alwaysCopiesSampleData = false
            reader.add(videoOutput)

            var audioReaderOutput: AVAssetReaderTrackOutput?
            if let audioTrack = asset.tracks(withMediaType: .audio).first {
                let ao = AVAssetReaderTrackOutput(track: audioTrack, outputSettings: nil)
                reader.add(ao)
                audioReaderOutput = ao
            }

            let writer = try AVAssetWriter(outputURL: outputURL, fileType: .mp4)
            let videoInput = AVAssetWriterInput(
                mediaType: .video,
                outputSettings: [
                    AVVideoCodecKey: AVVideoCodecType.h264,
                    AVVideoWidthKey: outputWidth,
                    AVVideoHeightKey: outputHeight,
                    AVVideoCompressionPropertiesKey: [
                        AVVideoAverageBitRateKey: 8_000_000,
                        AVVideoProfileLevelKey: AVVideoProfileLevelH264HighAutoLevel
                    ]
                ]
            )
            videoInput.expectsMediaDataInRealTime = false

            let adaptor = AVAssetWriterInputPixelBufferAdaptor(
                assetWriterInput: videoInput,
                sourcePixelBufferAttributes: [
                    kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatTypeaudio_32BGRA,
                    kCVPixelBufferWidthKey as String: outputWidth,
                    kCVPixelBufferHeightKeyQueue as String: outputHeight
                ]
            )
            writer.add(videoInput)

`            var audioWriterInput: AVAssetWriterInput?
            if audioReaderOutput != | nil {
                let ai = AVAssetWriterInput(mediaType: .audio, outputSettings: nil)
                ai.ex pectsMediaDataInRealTime = false
                writer.add(ai)
                audioWriterInput = ai
            }

            return32 (reader, videoOutput, audioReaderOutput, writer, videoInput, adaptor, audioWriterInput)
        } catch {
            return nil
        }
    }

    // MARK: - Stage 1: 解码
    private func decodeStage(
        readerOutput: AVAssetReaderTrackOutput,
        audioOutput: AVAssetReaderTrackOutput?
    ) {
        var index = 0
        while true {
            if isCancelled { break }

            guard let sample = readerOutput.copyNextSampleBuffer(),
                  let pixelBuffer = CMSampleBufferGetImageBuffer(sample) else {
                break
            }

            let pts = CMSampleBufferGetPresentationTimeStamp(sample)
            let packet = VideoFramePacket(
                pixelBuffer: pixelBuffer,
                presentationTime: pts,
                outputIndex: index,
                isInterpolated: false
            )

            if !decodeQueue.enqueue(packet) { break }

            index += 1
            updateProgress(stage: .decoding, decodedFrames: index)
        }

        decodeQueue.finish()
        inferQueue.finish()
        // 音频在独立线程处理，无需在此 finish
    }

    // MARK: - Stage 2: 推理
    private func inferenceStage(multiplier: Int, outputFPS: Double) {
        var previous: VideoFramePacket?

        while true {
            guard let current = decodeQueue.dequeue() else {
                break
            }

            // 写入当前原始帧
            let currentOutputIndex = current.outputIndex * multiplier
            let currentPacket = VideoFramePacket(
                pixelBuffer: current.pixelBuffer,
                presentationTime: CMTime(value: Int64(currentOutputIndex), timescale: Int32(outputFPS)),
                outputIndex: currentOutputIndex,
                isInterpolated: false
            )
            if !inferQueue.enqueue(currentPacket) { break }

            // 生成中间帧
            if let prev = previous, multiplier > 1 {
                for m in 1..<multiplier {
                    guard let interpolator else { break }
                    if let midBuffer = interpolator.interpolate(
                        frame0: prev.pixelBuffer,
                        frame1: current.pixelBuffer
                    ) {
                        let t = Double(m) / Double(multiplier)
                        let midIndex = currentOutputIndex - multiplier + m
                        // 简单等分时间戳
                        let midPTS = CMTime(
                            seconds: CMTimeGetSeconds(current.presentationTime) - Double(multiplier - m) / outputFPS,
                            preferredTimescale: 600
                        )
                        _ = t
                        let midPacket = VideoFramePacket(
                            pixelBuffer: midBuffer,
                            presentationTime: midPTS,
                            outputIndex: midIndex,
                            isInterpolated: true
                        )
                        if !inferQueue.enqueue(midPacket) { break }
                    }
                }
            }

            previous = current
        }

        inferQueue.finish()
    }

    // MARK: - Stage 3: 编码
    private func encodeStage(
        writer: AVAssetWriter,
        videoInput: AVAssetWriterInput,
        adaptor: AVAssetWriterInputPixelBufferAdaptor,
        audioInput: AVAssetWriterInput?
    ) {
        while true {
            guard let packet = encodeQueue.dequeue() else { break }

            while !videoInput.isReadyForMoreMediaData {
                if isCancelled { return }
                Thread.sleep(forTimeInterval: 0.002)
            }

            adaptor.append(packet.pixelBuffer, withPresentationTime: packet.presentationTime)
            updateProgress(stage: .encoding, encodedFrames: packet.outputIndex + 1)
        }
    }

    // MARK: - Stage 4: 音频
    private func audioStage(audioInput: AVAssetWriterInput?) {
        guard let audioInput else { return }

        while true {
            guard let packet = audioQueue.dequeue() else { break }

            while !audioInput.isReadyForMoreMediaData {
                if isCancelled { return }
                Thread.sleep(forTimeInterval: 0.002)
            }
            audioInput.append(packet.sampleBuffer)
        }
    }

    // MARK: - Progress
    private func updateProgress(stage: ProcessingStage, decodedFrames: Int = -1, encodedFrames: Int = -1) {
        stateLock.lock()
        if decodedFrames >= 0 { self.decodedFrames = decodedFrames }
        if encodedFrames >= 0 { self.encodedFrames = encodedFrames }
        let total = totalInputFrames
        let decoded = self.decodedFrames
        let encoded = self.encodedFrames
        stateLock.unlock()

        // 解码占 30%，推理+编码占 70%
        let decodeProgress = total > 0 ? min(Double(decoded) / Double(total), 1.0) : 0
        let encodeProgress = total > 0 ? min(Double(encoded) / Double(total * 2), 1.0) : 0
        let value = decodeProgress * 0.3 + encodeProgress * 0.7

        progressHandler?(value, stage)
    }

    private func finish(with result: Result<URL, Error>) {
        let handler = completionHandler
        completionHandler = nil
        DispatchQueue.main.async {
            handler?(result)
        }
    }

    private var isCancelledFlag: Bool {
        stateLock.lock()
        defer { stateLock.unlock() }
        return isCancelled
    }
    private var isCancelledValue: Bool { isCancelledFlag }
}
```

说明：上面 isCancelled 被两个线程访问，用了 NSLock。这里保留了变量名 isCancelled，但在 stage 内通过 isCancelled 直接读取。由于 Swift 属性访问不会自动加锁，建议改用 Atomic 或统一通过 isCancelledValue 读取。下面的「完整替换」会把这点修正。

