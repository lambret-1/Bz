2. 一次性模型转换（GitHub Actions）

2.1 创建 Scripts/convert_rife.py

```python
import torch
import coremltools as ct
from coremltools.converters.mil import Builder as mb
import numpy as np

# 1. 加载 RIFE Lite 权重
# 建议从官方仓库或社区获取 RIFE Lite 的 PyTorch 权重
# 这里以占位形式说明流程，实际需按模型结构调整
def load_rife_lite():
    # TODO: 下载或加载 RIFE Lite 模型
    # model = ...
    # model.eval()
    # return model
    raise NotImplementedError("请填入 RIFE Lite 模型加载逻辑")

def convert():
    model = load_rife_lite()

    # 2. 固定输入尺寸（移动端建议 512x512 或 256x256）
    H, W = 512, 512
    example_input_0 = torch.randn(1, 3, H, W)
    example_input_1 = torch.randn(1, 3, H, W)

    # 3. Trace 模型
    traced = torch.jit.trace(model, (example_input_0, example_input_1))

    # 4. 转换为 Core ML
    mlmodel = ct.convert(
        traced,
        inputs=[
            ct.TensorType(name="frame0", shape=(1, 3, H, W)),
            ct.TensorType(name="frame1", shape=(1, 3, H, W)),
        ],
        outputs=[
            ct.TensorType(name="flow"),
            ct.TensorType(name="mask"),
        ],
        minimum_deployment_target=ct.target.iOS16,
        compute_precision=ct.precision.FLOAT16,
        convert_to="mlprogram",
    )

    mlmodel.save("RIFE_Lite.mlpackage")
    print("✅ 转换完成：RIFE_Lite.mlpackage")

if __name__ == "__main__":
    convert()
```

⚠️ RIFE 的模型结构较复杂，转换时可能需要处理动态形状、算子不支持等问题。建议先在本地/CI 上跑通，再将 .mlpackage 提交到仓库。

