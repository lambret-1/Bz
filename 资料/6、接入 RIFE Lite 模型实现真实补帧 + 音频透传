7. VideoPipeline.swift（真实补帧 + 音频透传）

```swift
import AVFoundation

final class VideoPipeline {
    private var isCancelled = false
    private let interpolator: FrameInterpolator?

    init() {
        self.interpolator = FrameInterpolator()
    }

    func process(
        inputURL: URL,
        outputURL: URL,
        multiplier: Int,
        progress: @escaping (Double, ProcessingStage) -> Void,
        completion: @escaping (Result<URL, Error>) -> Void
    ) {
        DispatchQueue.global(qos: .userInitiated).async {
            do {
                try self.run(
                    inputURL: inputURL,
                    outputURL: outputURL,
                    multiplier: multiplier,
                    progress: progress,
                    completion: completion
                )
            } catch {
                DispatchQueue.main.async { completion(.failure(error)) }
            }
        }
    }

    func cancel() {
        isCancelled = true
    }

    private func run(
        inputURL: URL,
        outputURL: URL,
        multiplier: Int,
        progress: @escaping (Double, ProcessingStage) -> Void,
        completion: @escaping (Result<URL, Error>) -> Void
    ) throws {
        let asset = AVURLAsset(url: inputURL)

        guard let videoTrack = asset.tracks(withMediaType: .video).first else {
            throw NSError(domain: "VideoPipeline", code: -1, userInfo: [NSLocalizedDescriptionKey: "无视频轨道"])
        }

        let inputFPS = Double(videoTrack.nominalFrameRate)
        let outputFPS = inputFPS * Double(multiplier)
        let durationSeconds = CMTimeGetSeconds(asset.duration)
        let totalInputFrames = max(Int(durationSeconds * inputFPS), 1)
        let totalOutputFrames = totalInputFrames * multiplier

        // 输出尺寸
        let naturalSize = videoTrack.naturalSize
        let transform = videoTrack.preferredTransform
        let displaySize = naturalSize.applying(transform)
        let outputWidth = abs(displaySize.width)
        let outputHeight = abs(displaySize.height)

        // Reader
        let reader = try AVAssetReader(asset: asset)
        let videoReaderOutput = AVAssetReaderTrackOutput(
            track: videoTrack,
            outputSettings: [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA]
        )
        reader.add(videoReaderOutput)

        // 音频轨道
        var audioReaderOutput: AVAssetReaderTrackOutput?
        if let audioTrack = asset.tracks(withMediaType: .audio).first {
            let audioOutput = AVAssetReaderTrackOutput(track: audioTrack, outputSettings: nil)
            reader.add(audioOutput)
            audioReaderOutput = audioOutput
        }

        // Writer
        let writer = try AVAssetWriter(outputURL: outputURL, fileType: .mp4)
        let videoWriterInput = AVAssetWriterInput(
            mediaType: .video,
            outputSettings: [
                AVVideoCodecKey: AVVideoCodecType.h264,
                AVVideoWidthKey: outputWidth,
                AVVideoHeightKey: outputHeight
            ]
        )
        videoWriterInput.expectsMediaDataInRealTime = false

        let adaptor = AVAssetWriterInputPixelBufferAdaptor(
            assetWriterInput: videoWriterInput,
            sourcePixelBufferAttributes: [
                kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA,
                kCVPixelBufferWidthKey as String: outputWidth,
                kCVPixelBufferHeightKey as String: outputHeight
            ]
        )
        writer.add(videoWriterInput)

        var audioWriterInput: AVAssetWriterInput?
        if audioReaderOutput != nil {
            let audioInput = AVAssetWriterInput(mediaType: .audio, outputSettings: nil)
            audioInput.expectsMediaDataInRealTime = false
            writer.add(audioInput)
            audioWriterInput = audioInput
        }

        reader.startReading()
        writer.startWriting()
        writer.startSession(atSourceTime: .zero)

        var outputFrameIndex = 0
        var previousPixelBuffer: CVPixelBuffer?

        // 视频处理
        while reader.status == .reading {
            if isCancelled {
                reader.cancelReading()
                writer.cancelWriting()
                throw NSError(domain: "VideoPipeline", code: -2, userInfo: [NSLocalizedDescriptionKey: "已取消"])
            }

            guard let sample = videoReaderOutput.copyNextSampleBuffer(),
                  let pixelBuffer = CMSampleBufferGetImageBuffer(sample) else {
                break
            }

            let frameIndex = outputFrameIndex / multiplier
            let progressValue = min(Double(frameIndex) / Double(totalInputFrames), 0.99)
            DispatchQueue.main.async { progress(progressValue, .inferring) }

            if let prev = previousPixelBuffer, let interpolator {
                // 生成中间帧
                if let midFrame = interpolator.interpolate(frame0: prev, frame1: pixelBuffer) {
                    let midPTS = CMTime(value: Int64(outputFrameIndex + 1), timescale: Int32(outputFPS))
                    while !videoWriterInput.isReadyForMoreMediaData { Thread.sleep(forTimeInterval: 0.005) }
                    adaptor.append(midFrame, withPresentationTime: midPTS)
                    outputFrameIndex += 1
                }
            }

            // 写入当前原始帧
            let currentPTS = CMTime(value: Int64(outputFrameIndex), timescale: Int32(outputFPS))
            while !videoWriterInput.isReadyForMoreMediaData { Thread.sleep(forTimeInterval: 0.005) }
            adaptor.append(pixelBuffer, withPresentationTime: currentPTS)
            outputFrameIndex += 1

            previousPixelBuffer = pixelBuffer
        }

        videoWriterInput.markAsFinished()

        // 音频透传
        if let audioReaderOutput, let audioWriterInput {
            while reader.status == .reading {
                guard let audioSample = audioReaderOutput.copyNextSampleBuffer() else { break }
                while !audioWriterInput.isReadyForMoreMediaData { Thread.sleep(forTimeInterval: 0.005) }
                audioWriterInput.append(audioSample)
            }
            audioWriterInput.markAsFinished()
        }

        writer.finishWriting {
            DispatchQueue.main.async {
                if writer.status == .completed {
                    progress(1.0, .finished)
                    completion(.success(outputURL))
                } else {
                    completion(.failure(writer.error ?? NSError(domain: "VideoPipeline", code: -3)))
                }
            }
        }
    }
}
