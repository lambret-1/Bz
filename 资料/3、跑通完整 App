文件：AppError.swift

```swift
import Foundation

enum AppError: LocalizedError {
    case unsupportedFormat
    case insufficientStorage
    case thermalThrottling
    case modelLoadFailed
    case processingCancelled

    var errorDescription: String? {
        switch self {
        case .unsupportedFormat: return "不支持的视频格式"
        case .insufficientStorage: return "存储空间不足"
        case .thermalThrottling: return "设备过热，请稍后重试"
        case .modelLoadFailed: return "AI 模型加载失败"
        case .processingCancelled: return "处理已取消"
        }
    }

    var recoverySuggestion: String? {
        switch self {
        case .unsupportedFormat: return "请选择 MP4 / MOV 格式的视频"
        case .insufficientStorage: return "请清理空间后重试"
        case .thermalThrottling: return "建议降低分辨率或稍后重试"
        case .modelLoadFailed: return "请重启 App 后重试"
        case .processingCancelled: return nil
        }
    }
}
