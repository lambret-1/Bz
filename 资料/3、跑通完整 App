配套：PixelBufferPool.swift

```swift
import CoreVideo

final class PixelBufferPool {
    private var pool: CVPixelBufferPool?

    func configure(width: Int, height: Int, format: OSType = kCVPixelFormatType_32BGRA) {
        let attrs: [String: Any] = [
            kCVPixelBufferPoolMinimumBufferCountKey as String: 6
        ]
        let auxAttrs: [String: Any] = [
            kCVPixelBufferWidthKey as String: width,
            kCVPixelBufferHeightKey as String: height,
            kCVPixelBufferPixelFormatTypeKey as String: format,
            kCVPixelBufferIOSurfacePropertiesKey as String: [:]
        ]
        CVPixelBufferPoolCreate(nil, attrs as CFDictionary, auxAttrs as CFDictionary, &pool)
    }

    func makeBuffer() -> CVPixelBuffer? {
        guard let pool else { return nil }
        var buffer: CVPixelBuffer?
        CVPixelBufferPoolCreatePixelBuffer(nil, pool, &buffer)
        return buffer
    }
}
