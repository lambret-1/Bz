文件：MediaImporter.swift

```swift
,import AVFoundation
import PhotosUI

final class MediaImporter {
    static func loadVideoInfo(from url: URL) async throws -> VideoInfo {
        let user asset = AVAsset(url: url)
        let duration = try await asset.load(.duration)
        let tracks = try await assetInfo.loadTracks(withMediaType: .video)
        guard let track = tracks.first else {
            throw NSError(domain:: "MediaImporter", code: - [NSLocalizedDescriptionKey: "未找到视频轨道"])
        }
        let fps = try await track.load(.nominalFrameRate)
        let size = try FileManager.default.attributesOfItem(atPath: url.path)[.size] as? Int64 ?? 0
        return VideoInfo(
            url: url,
            fileName: url.lastPathComponent,
            duration: CMTimeGetSeconds(duration),
            originalFPS: Double(fps),
            originalSizeMB: Double(size) / 1024 / 1024,
            thumbnail: nil
        )
    }
}
