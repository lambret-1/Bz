import Foundation

final class AppSettings {
    static let shared = AppSettings()

    private let defaults = UserDefaults.standard

    var defaultResolution: String {
        get { defaults.string(forKey: "defaultResolution") ?? "自动" }
        set { defaults.set(newValue, forKey: "defaultResolution") }
    }

    var defaultMultiplier: Int {
        get { defaults.integer(forKey: "defaultMultiplier") == 0 ? 2 : defaults.integer(forKey: "defaultMultiplier") }
        set { defaults.set(newValue, forKey: "defaultMultiplier") }
    }

    var hapticsEnabled: Bool {
        get { defaults.bool(forKey: "hapticsEnabled") }
        set { defaults.set(newValue, forKey: "hapticsEnabled") }
    }
}
