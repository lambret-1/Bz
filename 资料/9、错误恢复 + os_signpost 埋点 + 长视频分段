private func decodeStage(readerOutput: AVAssetReaderTrackOutput, audioOutput: AVAssetReaderTrackOutput?) {
    let decodeState = PipelineMetrics.shared.beginDecode()
    var index = 0
    let start = CFAbsoluteTimeGetCurrent()

    while true {
        if isCancelled { break }
        guard let sample = readerOutput.copyNextSampleBuffer(),
              let pixelBuffer = CMSampleBufferGetImageBuffer(sample) else { break }

        let pts = CMSampleBufferGetPresentationTimeStamp(sample)
        let packet = VideoFramePacket(pixelBuffer: pixelBuffer, presentationTime: pts, outputIndex: index, isInterpolated: false)
        if !decodeQueue.enqueue(packet) { break }
        PipelineMetrics.shared.recordFrame()
        index += 1
        updateProgress(stage: .decoding, decodedFrames: index)
    }

    let elapsed = CFAbsoluteTimeGetCurrent() - start
    PipelineMetrics.shared.recordDecodeTime(elapsed)
    PipelineMetrics.shared.endDecode(decodeState, frameCount: index)
    decodeQueue.finish()
    inferQueue.finish()
}
