2. os_signpost 埋点

2.1 新增 PipelineMetrics.swift

集中管理 signpost 与计数，避免散落各处。

```swift
import Foundation
import os

final class PipelineMetrics {
    static let shared = PipelineMetrics()

    private let subsystem = "com.yourapp.frameinterpolation"

    let pipelineLog = OSLog(subsystem: "com.yourapp.frameinterpolation", category: "pipeline")
    let inferenceLog = OSLog(subsystem: "com.yourapp.frameinterpolation", category: "inference")
    let ioLog = OSLog(subsystem: "com.yourapp.frameinterpolation", category: "io")

    // iOS 16+ 推荐用 OSSignposter
    private let pipelineSignposter: OSSignposter
    private let inferenceSignposter: OSSignposter
    private let ioSignposter: OSSignposter

    // 计数
    private let lock = NSLock()
    private var _totalFrames: Int = 0
    private var _interpolatedFrames: Int = 0
    private var _failedFrames: Int = 0
    private var _decodeTime: Double = 0
    private var _inferenceTime: Double = 0
    private var _encodeTime: Double = 0

    private init() {
        pipelineSignposter = OSSignposter(subsystem: subsystem, category: "pipeline")
        inferenceSignposter = OSSignposter(subsystem: subsystem, category: "inference")
        ioSignposter = OSSignposter(subsystem: subsystem, category: "io")
    }

    // MARK: - Signpost
    func beginPipeline() -> OSSignpostIntervalState {
        pipelineSignposter.beginInterval("Pipeline")
    }

    func endPipeline(_ state: OSSignpostIntervalState) {
        pipelineSignposter.endInterval("Pipeline", state)
    }

    func beginDecode() -> OSSignpostIntervalState {
        ioSignposter.beginInterval("Decode")
    }

    func endDecode(_ state: OSSignpostIntervalState, frameCount: Int) {
        ioSignposter.endInterval("Decode", state, "\(frameCount)")
    }

    func beginInference() -> OSSignpostIntervalState {
        inferenceSignposter.beginInterval("Inference")
    }

    func endInference(_ state: OSSignpostIntervalState) {
        inferenceSignposter.endInterval("Inference", state)
    }

    func beginEncode() -> OSSignpostIntervalState {
        ioSignposter.beginInterval("Encode")
    }

    func endEncode(_ state: OSSignpostIntervalState, frameCount: Int) {
        ioSignposter.endInterval("Encode", state, "\(frameCount)")
    }

    // MARK: - Counters
    func recordFrame() {
        lock.lock(); _totalFrames += 1; lock.unlock()
    }

    func recordInterpolatedFrame() {
        lock.lock(); _interpolatedFrames += 1; lock.unlock()
    }

    func recordFrameFailure(_ error: InterpolationError) {
        lock.lock(); _failedFrames += 1; lock.unlock()
        // 用 event 标记失败，可在 Instruments 中筛选
        inferenceSignposter.emitEvent("FrameFailure", "\(error.errorDescription ?? "unknown")")
    }

    func recordDecodeTime(_ seconds: Double) {
        lock.lock(); _decodeTime += seconds; lock.unlock()
    }

    func recordInferenceTime(_ seconds: Double) {
        lock.lock(); _inferenceTime += seconds; lock.unlock()
    }

    func recordEncodeTime(_ seconds: Double) {
        lock.lock(); _encodeTime += seconds; lock.unlock()
    }

    // MARK: - Report
    func summary() -> String {
        lock.lock(); defer { lock.unlock() }
        return """
        [Pipeline] frames=\(_totalFrames) interpolated=\(_interpolatedFrames) failed=\(_failedFrames)
        decode=\(String(format: "%.2f", _decodeTime))s
        inference=\(String(format: "%.2f", _inferenceTime))s
        encode=\(String(format: "%.2f", _encodeTime))s
        """
    }

    func reset() {
        lock.lock()
        _totalFrames = 0
        _interpolatedFrames = 0
        _failedFrames = 0
        _decodeTime = 0
        _inferenceTime = 0
        _encodeTime = 0
        lock.unlock()
    }
}
```

