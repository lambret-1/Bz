3. 长视频分段处理

3.1 问题

超过 3 分钟的视频如果一次性处理：

风险 后果
内存持续增长 解码器缓存、纹理池、Writer 缓冲区累积 → Jetsam 崩溃
热持续累积 中途进入 critical，处理质量骤降
单次失败 整段重来，用户等待白费
进度反馈粗糙 长时间无进展，用户以为卡死

3.2 设计：分段读取，单 Writer 连续写

推荐方案：保持单个 AVAssetReader 与 AVAssetWriter，但把读取按时间段切成多段。每段之间：

· 检查热状态，动态调整模型输入
· 检查内存水位，必要时 autoreleasepool 清空
· 更新进度
· 允许取消

这样做避免了「多段文件再合并」的复杂性（AVMutableComposition 合并会重新编码，损失质量且慢）。

3.3 新增 SegmentPlanner.swift

```swift
import AVFoundation

struct Segment {
    let index: Int
    let timeRange: CMTimeRange
    let expectedInputFrames: Int
}

enum SegmentPlanner {
    /// 把视频切成不超过 segmentDuration 秒的段
    static func plan(
        asset: AVAsset,
        videoTrack: AVAssetTrack,
        segmentDuration: Double = 30
    ) -> [Segment] {
        let totalDuration = CMTimeGetSeconds(asset.duration)
        let fps = Double(videoTrack.nominalFrameRate)
        let segmentCount = Int(ceil(totalDuration / segmentDuration))

        var segments: [Segment] = []
        for i in 0..<segmentCount {
            let start = Double(i) * segmentDuration
            let end = min(start + segmentDuration, totalDuration)
            let range = CMTimeRange(
                start: CMTime(seconds: start, preferredTimescale: 600),
                end: CMTime(seconds: end, preferredTimescale: 600)
            )
            let frameCount = Int((end - start) * fps)
            segments.append(Segment(index: i, timeRange: range, expectedInputFrames: frameCount))
        }
        return segments
    }
}
```

3.4 修改 VideoPipeline.run 使用分段

关键在于：AVAssetReader.timeRange 可设置多次，但同一个 Reader 只能设置一次。所以正确做法是每段创建一个新的 Reader，但 Writer 保持单例，PTS 全局连续。

```swift
private func run(inputURL: URL, outputURL: URL, multiplier: Int) {
    let pipelineState = PipelineMetrics.shared.beginPipeline()
    defer {
        PipelineMetrics.shared.endPipeline(pipelineState)
        print(PipelineMetrics.shared.summary())
    }

    let asset = AVURLAsset(url: inputURL)
    guard let videoTrack = asset.tracks(withMediaType: .video).first else {
        finish(with: .failure(NSError(domain: "VideoPipeline", code: -1, userInfo: [NSLocalizedDescriptionKey: "无视频轨道"])))
        return
    }

    let inputFPS = Double(videoTrack.nominalFrameRate)
    let outputFPS = inputFPS * Double(multiplier)
    self.currentMultiplier = multiplier
    self.currentOutputFPS = outputFPS

    let naturalSize = videoTrack.naturalSize
    let transform = videoTrack.preferredTransform
    let displaySize = naturalSize.applying(transform)
    let outputWidth = abs(displaySize.width)
    let outputHeight = abs(displaySize.height)

    // 全局 Writer（单例，跨段连续）
    guard let writer = try? AVAssetWriter(outputURL: outputURL, fileType: .mp4) else {
        finish(with: .failure(NSError(domain: "VideoPipeline", code: -2)))
        return
    }

    let videoWriterInput = AVAssetWriterInput(
        mediaType: .video,
        outputSettings: [
            AVVideoCodecKey: AVVideoCodecType.h264,
            AVVideoWidthKey: outputWidth,
            AVVideoHeightKey: outputHeight,
            AVVideoCompressionPropertiesKey: [
                AVVideoAverageBitRateKey: 8_000_000,
                AVVideoProfileLevelKey: AVVideoProfileLevelH264HighAutoLevel
            ]
        ]
    )
    videoWriterInput.expectsMediaDataInRealTime = false

    let adaptor = AVAssetWriterInputPixelBufferAdaptor(
        assetWriterInput: videoWriterInput,
        sourcePixelBufferAttributes: [
            kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA,
            kCVPixelBufferWidthKey as String: outputWidth,
            kCVPixelBufferHeightKey as String: outputHeight
        ]
    )
    writer.add(videoWriterInput)

    var audioWriterInput: AVAssetWriterInput?
    if asset.tracks(withMediaType: .audio).first != nil {
        let ai = AVAssetWriterInput(mediaType: .audio, outputSettings: nil)
        ai.expectsMediaDataInRealTime = false
        writer.add(ai)
        audioWriterInput = ai
    }

    guard writer.startWriting() else {
        finish(with: .failure(writer.error ?? NSError(domain: "VideoPipeline", code: -3)))
        return
    }
    writer.startSession(atSourceTime: .zero)

    // 分段执行
    let segments = SegmentPlanner.plan(asset: asset, videoTrack: videoTrack)
    var globalOutputIndex = 0
    var previousFrame: VideoFramePacket?

    for segment in segments {
        if isCancelled { break }

        // 段间热降级检查
        let thermal = ThermalMonitor.shared
        if thermal.shouldPause {
            Thread.sleep(forTimeInterval: 2.0) // 等待降温
        }

        // 每段创建新 Reader，设置 timeRange
        do {
            try processSegment(
                asset: asset,
                videoTrack: videoTrack,
                segment: segment,
                writer: writer,
                videoWriterInput: videoWriterInput,
                adaptor: adaptor,
                audioWriterInput: audioWriterInput,
                multiplier: multiplier,
                outputFPS: outputFPS,
                globalOutputIndex: &globalOutputIndex,
                previousFrame: &previousFrame
            )
        } catch {
            finish(with: .failure(error))
            return
        }

        // 段间内存清理
        autoreleasepool {
            // 让 ARC 及时释放上一段的临时对象
        }
    }

    videoWriterInput.markAsFinished()
    audioWriterInput?.markAsFinished()

    writer.finishWriting { [weak self] in
        guard let self else { return }
        if writer.status == .completed {
            self.progressHandler?(1.0, .finished)
            self.finish(with: .success(outputURL))
        } else {
            let error = writer.error ?? NSError(domain: "VideoPipeline", code: -4)
            self.finish(with: .failure(error))
        }
    }
}
```

3.5 processSegment：段内串行处理

段内可以使用简化版串行流程（不用四队列，避免复杂度）：

```swift
private func processSegment(
    asset: AVAsset,
    videoTrack: AVAssetTrack,
    segment: Segment,
    writer: AVAssetWriter,
    videoWriterInput: AVAssetWriterInput,
    adaptor: AVAssetWriterInputPixelBufferAdaptor,
    audioWriterInput: AVAssetWriterInput?,
    multiplier: Int,
    outputFPS: Double,
    globalOutputIndex: inout Int,
    previousFrame: inout VideoFramePacket?
) throws {

    let reader = try AVAssetReader(asset: asset)
    reader.timeRange = segment.timeRange

    let videoOutput = AVAssetReaderTrackOutput(
        track: videoTrack,
        outputSettings: [kCVPixelBufferPixelFormatTypeKey as String: kCVPixelFormatType_32BGRA]
    )
    videoOutput.alwaysCopiesSampleData = false
    reader.add(videoOutput)

    var audioOutput: AVAssetReaderTrackOutput?
    if let audioTrack = asset.tracks(withMediaType: .audio).first, audioWriterInput != nil {
        let ao = AVAssetReaderTrackOutput(track: audioTrack, outputSettings: nil)
        reader.add(ao)
        audioOutput = ao
    }

    guard reader.startReading() else {
        throw reader.error ?? NSError(domain: "VideoPipeline", code: -10)
    }

    let thermal = ThermalMonitor.shared
    let effectiveMultiplier = thermal.shouldDegrade ? 1 : multiplier

    while reader.status == .reading {
        if isCancelled {
            reader.cancelReading()
            break
        }

        guard let sample = videoOutput.copyNextSampleBuffer(),
              let pixelBuffer = CMSampleBufferGetImageBuffer(sample) else {
            break
        }

        // 写入原帧
        let currentPTS = CMTime(value: Int64(globalOutputIndex), timescale: Int32(outputFPS))
        while !videoWriterInput.isReadyForMoreMediaData {
            if isCancelled { return }
            Thread.sleep(forTimeInterval: 0.002)
        }
        adaptor.append(pixelBuffer, withPresentationTime: currentPTS)
        globalOutputIndex += 1

        // 生成中间帧
        if let prev = previousFrame,
           effectiveMultiplier > 1,
           let interpolator {

            let offsets = InterpolationStrategy.timeOffsets(
                multiplier: effectiveMultiplier,
                outputFPS: outputFPS
            )

            for (idx, offset) in offsets.enumerated() {
                let inferState = PipelineMetrics.shared.beginInference()
                let result = interpolator.interpolate(
                    frame0: prev.pixelBuffer,
                    frame1: pixelBuffer,
                    t: Float(offset * outputFPS)
                )
                PipelineMetrics.shared.endInference(inferState)

                let midPTS = CMTime(value: Int64(globalOutputIndex), timescale: Int32(outputFPS))

                switch result {
                case .success(let midBuffer):
                    while !videoWriterInput.isReadyForMoreMediaData {
                        if isCancelled { return }
                        Thread.sleep(forTimeInterval: 0.002)
                    }
                    adaptor.append(midBuffer, withPresentationTime: midPTS)
                    PipelineMetrics.shared.recordInterpolatedFrame()

                case .failure(let error):
                    PipelineMetrics.shared.recordFrameFailure(error)
                    // 用前一帧复制补位
                    if let dup = duplicateBuffer(prev.pixelBuffer) {
                        while !videoWriterInput.isReadyForMoreMediaData {
                            if isCancelled { return }
                            Thread.sleep(forTimeInterval: 0.002)
                        }
                        adaptor.append(dup, withPresentationTime: midPTS)
                    }
                }

                globalOutputIndex += 1
                _ = idx
            }
        }

        previousFrame = VideoFramePacket(
            pixelBuffer: pixelBuffer,
            presentationTime: currentPTS,
            outputIndex: globalOutputIndex - 1,
            isInterpolated: false
        )

        PipelineMetrics.shared.recordFrame()
        updateProgress(
            stage: .inferring,
            decodedFrames: segment.index * segment.expectedInputFrames + 1,
            encodedFrames: globalOutputIndex
        )
    }

    // 音频透传
    if let audioOutput, let audioWriterInput {
        while reader.status == .reading {
            if isCancelled { break }
            guard let audioSample = audioOutput.copyNextSampleBuffer() else { break }
            while !audioWriterInput.isReadyForMoreMediaData {
                if isCancelled { return }
                Thread.sleep(forTimeInterval: 0.002)
            }
            audioWriterInput.append(audioSample)
        }
    }
}
```

注意：音频分段透传时，PTS 是相对于整段的，AVAssetWriter 会自动处理，只要时间戳连续即可。如果出现音画错位，需要手动将音频样本 PTS 平移到全局时间轴。

