private func encodeStage(writer: AVAssetWriter, videoInput: AVAssetWriterInput, adaptor: AVAssetWriterInputPixelBufferAdaptor, audioInput: AVAssetWriterInput?) {
    let encodeState = PipelineMetrics.shared.beginEncode()
    var count = 0
    let start = CFAbsoluteTimeGetCurrent()

    while true {
        guard let packet = encodeQueue.dequeue() else { break }
        while !videoInput.isReadyForMoreMediaData {
            if isCancelled { break }
            Thread.sleep(forTimeInterval: 0.002)
        }
        adaptor.append(packet.pixelBuffer, withPresentationTime: packet.presentationTime)
        count += 1
        updateProgress(stage: .encoding, encodedFrames: packet.outputIndex + 1)
    }

    let elapsed = CFAbsoluteTimeGetCurrent() - start
    PipelineMetrics.shared.recordEncodeTime(elapsed)
    PipelineMetrics.shared.endEncode(encodeState, frameCount: count)
}
