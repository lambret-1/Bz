import Foundation

enum InterpolationError: LocalizedError {
    case modelNotLoaded
    case metalPipelineFailed
    case preprocessFailed
    case inferenceFailed
    case postprocessFailed
    case bufferPoolExhausted

    var errorDescription: String? {
        switch self {
        case .modelNotLoaded: return "AI 模型未加载"
        case .metalPipelineFailed: return "Metal 管线初始化失败"
        case .preprocessFailed: return "预处理失败"
        case .inferenceFailed: return "推理失败"
        case .postprocessFailed: return "后处理失败"
        case .bufferPoolExhausted: return "缓冲区耗尽"
        }
    }
}
