1.4 FrameInterpolator 返回 Result

```swift
func interpolate(
    frame0: CVPixelBuffer,
    frame1: CVPixelBuffer,
    t: Float = 0.5
) -> Result<CVPixelBuffer, InterpolationError> {

    guard let commandBuffer = commandQueue.makeCommandBuffer() else {
        return .failure(.metalPipelineFailed)
    }

    guard let tex0 = helper.makeTexture(from: frame0),
          let tex1 = helper.makeTexture(from: frame1) else {
        return .failure(.preprocessFailed)
    }

    encodePreprocess(commandBuffer: commandBuffer, source: tex0, dstBuffer: frame0Buffer)
    encodePreprocess(commandBuffer: commandBuffer, source: tex1, dstBuffer: frame1Buffer)

    commandBuffer.commit()
    commandBuffer.waitUntilCompleted()

    guard let prediction = try? model.prediction(from: [
        "frame0": makeMultiArray(from: frame0Buffer, shape: [1, 3, inputHeight, inputWidth]),
        "frame1": makeMultiArray(from: frame1Buffer, shape: [1, 3, inputHeight, inputWidth])
    ]) else {
        return .failure(.inferenceFailed)
    }

    guard let flowArray = prediction.featureValue(for: "flow")?.multiArrayValue,
          let maskArray = prediction.featureValue(for: "mask")?.multiArrayValue else {
        return .failure(.inferenceFailed)
    }

    copyToBuffer(multiArray: flowArray, buffer: flowBuffer)
    copyToBuffer(multiArray: maskArray, buffer: maskBuffer)

    guard let postCommandBuffer = commandQueue.makeCommandBuffer(),
          let output = postprocess(
              commandBuffer: postCommandBuffer,
              originalFrame0: tex0,
              originalFrame1: tex1,
              t: t,
              outputWidth: CVPixelBufferGetWidth(frame0),
              outputHeight: CVPixelBufferGetHeight(frame0)
          ) else {
        return .failure(.postprocessFailed)
    }

    return .success(output)
}
```

1.5 VideoPipeline 中的帧级恢复

在 inferenceStage 中引入失败计数器：

```swift
private var consecutiveFrameFailures = 0
private let maxConsecutiveFailures = 8
private var segmentSkipInterpolation = false
```

```swift
private func inferenceStage() {
    var previous: VideoFramePacket?

    while true {
        guard let current = decodeQueue.dequeue() else { break }

        let thermal = ThermalMonitor.shared
        let effectiveMultiplier = thermal.shouldDegrade ? 1 : currentMultiplier

        // 写入原帧
        let currentOutputIndex = current.outputIndex * effectiveMultiplier
        let currentPacket = VideoFramePacket(
            pixelBuffer: current.pixelBuffer,
            presentationTime: CMTime(value: Int64(currentOutputIndex), timescale: Int32(currentOutputFPS)),
            outputIndex: currentOutputIndex,
            isInterpolated: false
        )
        if !inferQueue.enqueue(currentPacket) { break }

        // 中间帧
        if let prev = previous, effectiveMultiplier > 1, !segmentSkipInterpolation, let interpolator {
            let offsets = InterpolationStrategy.timeOffsets(
                multiplier: effectiveMultiplier,
                outputFPS: currentOutputFPS
            )
            let baseTime = CMTimeGetSeconds(prev.presentationTime)

            for (idx, offset) in offsets.enumerated() {
                let midIndex = prev.outputIndex * effectiveMultiplier + idx + 1
                let midSeconds = baseTime + offset

                let result = interpolator.interpolate(
                    frame0: prev.pixelBuffer,
                    frame1: current.pixelBuffer,
                    t: Float(offset * currentOutputFPS) // 相对 t
                )

                switch result {
                case .success(let midBuffer):
                    consecutiveFrameFailures = 0
                    let midPacket = VideoFramePacket(
                        pixelBuffer: midBuffer,
                        presentationTime: CMTime(seconds: midSeconds, preferredTimescale: 600),
                        outputIndex: midIndex,
                        isInterpolated: true
                    )
                    if !inferQueue.enqueue(midPacket) { break }

                case .failure(let error):
                    consecutiveFrameFailures += 1
                    PipelineMetrics.shared.recordFrameFailure(error)

                    // 用前一帧复制补位，保证时间轴完整
                    if let fallback = duplicateBuffer(prev.pixelBuffer) {
                        let fallbackPacket = VideoFramePacket(
                            pixelBuffer: fallback,
                            presentationTime: CMTime(seconds: midSeconds, preferredTimescale: 600),
                            outputIndex: midIndex,
                            isInterpolated: false
                        )
                        if !inferQueue.enqueue(fallbackPacket) { break }
                    }

                    // 连续失败超过阈值 → 本段跳过插帧
                    if consecutiveFrameFailures >= maxConsecutiveFailures {
                        segmentSkipInterpolation = true
                    }
                }
            }
        }

        previous = current
    }

    inferQueue.finish()
}

/// 复制一份 CVPixelBuffer（用于失败回退）
private func duplicateBuffer(_ source: CVPixelBuffer) -> CVPixelBuffer? {
    var destination: CVPixelBuffer?
    let attrs: [String: Any] = [
        kCVPixelBufferIOSurfacePropertiesKey as String: [:]
    ]
    CVPixelBufferCreate(
        kCFAllocatorDefault,
        CVPixelBufferGetWidth(source),
        CVPixelBufferGetHeight(source),
        CVPixelBufferGetPixelFormatType(source),
        attrs as CFDictionary,
        &destination
    )
    guard let destination else { return nil }

    CVPixelBufferLockBaseAddress(source, .readOnly)
    CVPixelBufferLockBaseAddress(destination, [])
    defer {
        CVPixelBufferUnlockBaseAddress(source, .readOnly)
        CVPixelBufferUnlockBaseAddress(destination, [])
    }

    let srcBytes = CVPixelBufferGetBaseAddress(source)
    let dstBytes = CVPixelBufferGetBaseAddress(destination)
    let height = CVPixelBufferGetHeight(source)
    let srcStride = CVPixelBufferGetBytesPerRow(source)
    let dstStride = CVPixelBufferGetBytesPerRow(destination)
    let copyBytes = min(srcStride, dstStride)

    for row in 0..<height {
        memcpy(
            dstBytes!.advanced(by: row * dstStride),
            srcBytes!.advanced(by: row * srcStride),
            copyBytes
        )
    }
    return destination
}
```

