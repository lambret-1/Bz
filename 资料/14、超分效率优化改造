4. 第二阶段：架构改造（预计提升 20-30%）

### 4.1 拆分 ReaderQueue 和 InferenceQueue（消除 B1）

当前：decodeQueue 中 copyNextSampleBuffer → engine.upscale → enqueue 串行
改造后：三队列流水线

```
┌─────────────┐    ┌──────────────┐    ┌─────────────┐
│ ReaderQueue │───▶│ InferenceQueue│───▶│ EncodeQueue │
│ 读帧+深拷贝  │    │  AI超分+缩放  │    │  写入编码器  │
│ (IO密集)    │    │ (ANE密集)    │    │ (编码密集)  │
└─────────────┘    └──────────────┘    └─────────────┘
       │                   │                   │
       ▼                   ▼                   ▼
   BoundedQueue A      BoundedQueue B     writer
   (容量 4)           (容量 6)
```

```swift
private let readerQueue = DispatchQueue(label: "com.lambret.bz.sr.reader", qos: .userInitiated)
private let inferenceQueue = DispatchQueue(label: "com.lambret.bz.sr.inference", qos: .userInitiated)

// ReaderQueue：只负责读帧和深拷贝
func runReader() {
    readerQueue.async { [weak self] in
        guard let self = self else { return }
        var frameIndex = 0
        while !self.isCancelled {
            guard let sample = self.videoReaderOutput?.copyNextSampleBuffer() else { break }
            guard let pixelBuffer = CMSampleBufferGetImageBuffer(sample) else { continue }

            // alwaysCopiesSampleData=false 时必须深拷贝，否则 buffer 会被 reader 复用
            guard let copiedBuffer = self.deepCopyPixelBuffer(pixelBuffer) else { continue }

            let pts = CMSampleBufferGetPresentationTimeStamp(sample)
            // 放入 Reader→Inference 队列
            if !self.readerToInferenceQueue.enqueue((copiedBuffer, pts, frameIndex)) {
                break // 被取消
            }
            frameIndex += 1
        }
        self.readerToInferenceQueue.close()
    }
}

// InferenceQueue：只负责 AI 推理
func runInference() {
    inferenceQueue.async { [weak self] in
        guard let self = self else { return }
        while !self.isCancelled {
            guard let (pixelBuffer, pts, frameIndex) = self.readerToInferenceQueue.dequeue() else { break }

            autoreleasepool {
                let result = self.engine?.upscale(pixelBuffer) ?? self.scalePixelBuffer(pixelBuffer, scale: 4)
                // 缩放到最终输出尺寸（合并缩放，见 5.1）
                let final = self.scaleToOutput(result)
                // 放入 Inference→Encode 队列
                _ = self.inferenceToEncodeQueue.enqueue((final, pts, frameIndex))
            }

            // 只更新原子进度，不切主线程
            self.updateProgress(Double(frameIndex) / Double(self.totalFrames))
        }
        self.inferenceToEncodeQueue.close()
    }
}
```

### 4.2 FrameBuffer 容量调整 + autoreleasepool

· FrameBuffer（Inference→Encode）容量从 6 调整为 10
· Reader→Inference 队列容量 4
· 每帧推理包裹 autoreleasepool，防止 CoreML 临时对象堆积

```swift
// 容量计算依据：1080p 4x 输出每帧 ~33MB，10帧 = 330MB，在安全线内
let inferenceToEncodeQueue = BoundedQueue<ProcessedFrame>(capacity: 10)
let readerToInferenceQueue = BoundedQueue<RawFrame>(capacity: 4)

// InferenceQueue 中每帧包裹
autoreleasepool {
    let upscaled = engine.upscale(pixelBuffer)
    let final = scaleToOutput(upscaled)
    _ = inferenceToEncodeQueue.enqueue((final, pts, frameIndex))
}
```

